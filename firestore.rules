rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidPatient(data) {
      return data.keys().hasAll(['id', 'name', 'abhaId']) &&
             data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 256 &&
             data.abhaId is string && data.abhaId.size() <= 64;
    }

    function isValidReport(data) {
      return data.keys().hasAll(['id', 'patientId', 'createdAt', 'summary', 'rawOutput']) &&
             data.id is string && data.id.size() <= 128 &&
             data.patientId is string && data.patientId.size() <= 128 &&
             data.createdAt is string && data.createdAt.size() <= 64 &&
             data.summary is map &&
             data.rawOutput is string && data.rawOutput.size() <= 100000 &&
             (!('ayushMode' in data) || data.ayushMode is bool) &&
             (!('allopathyDiagnosis' in data) || (data.allopathyDiagnosis is string && data.allopathyDiagnosis.size() <= 10000)) &&
             (!('allopathySuggestions' in data) || (data.allopathySuggestions is string && data.allopathySuggestions.size() <= 10000)) &&
             (!('ayushDiagnosis' in data) || (data.ayushDiagnosis is string && data.ayushDiagnosis.size() <= 10000)) &&
             (!('ayushSuggestions' in data) || (data.ayushSuggestions is string && data.ayushSuggestions.size() <= 10000));
    }

    function isValidAppointment(data) {
      return data.keys().hasAll(['id', 'reportId', 'patientId', 'patientName', 'doctorName', 'date', 'slot', 'status', 'createdAt']) &&
             data.id is string && data.id.size() <= 128 &&
             data.reportId is string && data.reportId.size() <= 128 &&
             data.patientId is string && data.patientId.size() <= 128 &&
             data.patientName is string && data.patientName.size() <= 256 &&
             data.doctorName is string && data.doctorName.size() <= 256 &&
             data.date is string && data.date.size() <= 64 &&
             data.slot is string && data.slot.size() <= 64 &&
             data.status is string && data.status.size() <= 64 &&
             data.createdAt is string && data.createdAt.size() <= 64;
    }

    match /patients/{patientId} {
      allow read: if true;
      allow create: if isValidId(patientId) && isValidPatient(incoming());
      allow update: if isValidId(patientId) && isValidPatient(incoming());
      allow delete: if false;
    }

    match /reports/{reportId} {
      allow read: if true;
      allow create: if isValidId(reportId) && isValidReport(incoming());
      allow update: if isValidId(reportId) && isValidReport(incoming());
      allow delete: if false;
    }
    
    match /appointments/{appointmentId} {
      allow read: if true;
      allow create: if isValidId(appointmentId) && isValidAppointment(incoming());
      allow update: if isValidId(appointmentId) && isValidAppointment(incoming());
      allow delete: if false;
    }
    
    match /doctors/{doctorId} {
      allow read, write: if true;
    }
    
    match /otps/{otpId} {
      allow read, write: if true;
    }

    match /doctor_databases/{doctorDbName} {
      allow read, write: if true;
    }

    match /doctor_databases/{doctorDbName}/{document=**} {
      allow read, write: if true;
    }
    
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
